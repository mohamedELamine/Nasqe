{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1280px",
			"wideSize": "1440px"
		},
		"color": {
			"palette": [
				{
					"slug": "primary-dark-green",
					"color": "#1a4d3e",
					"name": "الأخضر الداكن الأساسي"
				},
				{
					"slug": "primary-green",
					"color": "#2d6a4f",
					"name": "الأخضر الأساسي"
				},
				{
					"slug": "secondary-orange",
					"color": "#ff8c42",
					"name": "البرتقالي الثانوي"
				},
				{
					"slug": "bg-light",
					"color": "#f8f9fa",
					"name": "خلفية فاتحة"
				},
				{
					"slug": "text-dark",
					"color": "#1a1a1a",
					"name": "نص داكن"
				},
				{
					"slug": "text-gray",
					"color": "#6b7280",
					"name": "نص رمادي"
				},
				{
					"slug": "border-gray",
					"color": "#e5e7eb",
					"name": "حدود رمادية"
				},
				{
					"slug": "white",
					"color": "#ffffff",
					"name": "أبيض"
				}
			],
			"gradients": [
				{
					"slug": "primary-gradient",
					"gradient": "linear-gradient(135deg, #1a4d3e 0%, #2d6a4f 100%)",
					"name": "تدرج أخضر"
				},
				{
					"slug": "hero-gradient",
					"gradient": "linear-gradient(180deg, #f8f9fa 0%, #ffffff 100%)",
					"name": "تدرج خلفية Hero"
				},
				{
					"slug": "footer-gradient",
					"gradient": "linear-gradient(180deg, #1a4d3e 0%, #0f3329 100%)",
					"name": "تدرج Footer"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "\"Cairo\", \"IBM Plex Sans Arabic\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"slug": "primary",
					"name": "Cairo (الخط الأساسي)"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "صغير"
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "متوسط"
				},
				{
					"slug": "large",
					"size": "1.25rem",
					"name": "كبير"
				},
				{
					"slug": "x-large",
					"size": "1.5rem",
					"name": "كبير جداً"
				},
				{
					"slug": "xx-large",
					"size": "2rem",
					"name": "كبير جداً جداً"
				},
				{
					"slug": "xxx-large",
					"size": "2.5rem",
					"name": "عملاق"
				}
			],
			"lineHeight": true
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"units": ["px", "rem", "vh", "vw", "%"],
			"spacingSizes": [
				{
					"slug": "small",
					"size": "1.25rem",
					"name": "صغير (20px)"
				},
				{
					"slug": "medium",
					"size": "2rem",
					"name": "متوسط (32px)"
				},
				{
					"slug": "large",
					"size": "2.5rem",
					"name": "كبير (40px)"
				},
				{
					"slug": "x-large",
					"size": "5rem",
					"name": "كبير جداً (80px)"
				},
				{
					"slug": "section",
					"size": "7.5rem",
					"name": "قسم (120px)"
				}
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"custom": {
			"borderRadius": {
				"small": "8px",
				"medium": "12px",
				"large": "16px",
				"xl": "20px",
				"xxl": "24px"
			},
			"shadow": {
				"sm": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1)",
				"md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)",
				"lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1)",
				"xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1)",
				"2xl": "0 25px 50px -12px rgba(0, 0, 0, 0.25)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--text-dark)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--primary)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "0",
				"bottom": "0",
				"left": "0"
			}
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary-dark-green)",
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--primary)",
					"fontSize": "1rem",
					"fontWeight": "600"
				},
				"border": {
					"radius": "12px"
				},
				"spacing": {
					"padding": {
						"top": "1rem",
						"right": "2rem",
						"bottom": "1rem",
						"left": "2rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-green)"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary-dark-green)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-green)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--primary)",
					"fontWeight": "700",
					"lineHeight": "1.3"
				},
				"color": {
					"text": "var(--wp--preset--color--text-dark)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "2.5rem",
					"fontWeight": "800",
					"lineHeight": "1.2"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "2rem",
					"fontWeight": "700",
					"lineHeight": "1.3"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.5rem",
					"fontWeight": "700",
					"lineHeight": "1.4"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.25rem",
					"fontWeight": "600",
					"lineHeight": "1.5"
				}
			}
		},
		"blocks": {
			"core/paragraph": {
				"color": {
					"text": "var(--wp--preset--color--text-gray)"
				},
				"typography": {
					"lineHeight": "1.7"
				}
			},
			"core/group": {
				"spacing": {
					"padding": {
						"top": "0",
						"right": "0",
						"bottom": "0",
						"left": "0"
					}
				}
			},
			"core/columns": {
				"spacing": {
					"padding": {
						"top": "0",
						"right": "0",
						"bottom": "0",
						"left": "0"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "رأس الصفحة",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "تذييل الصفحة",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "front-page",
			"title": "الصفحة الرئيسية",
			"postTypes": ["page"]
		}
	]
}

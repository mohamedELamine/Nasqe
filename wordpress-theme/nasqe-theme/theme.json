{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "primary-dark-green",
          "color": "#1a4d3e",
          "name": "أخضر داكن رئيسي"
        },
        {
          "slug": "primary-green",
          "color": "#2d6a4f",
          "name": "أخضر رئيسي"
        },
        {
          "slug": "secondary-orange",
          "color": "#ff8c42",
          "name": "برتقالي ثانوي"
        },
        {
          "slug": "bg-light",
          "color": "#f8f9fa",
          "name": "خلفية فاتحة"
        },
        {
          "slug": "text-dark",
          "color": "#1a1a1a",
          "name": "نص داكن"
        },
        {
          "slug": "text-gray",
          "color": "#6b7280",
          "name": "نص رمادي"
        },
        {
          "slug": "border-gray",
          "color": "#e5e7eb",
          "name": "حدود رمادية"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "أبيض"
        }
      ],
      "gradients": [
        {
          "slug": "primary-gradient",
          "gradient": "linear-gradient(135deg, #1a4d3e 0%, #2d6a4f 100%)",
          "name": "تدرج رئيسي"
        },
        {
          "slug": "hero-gradient",
          "gradient": "linear-gradient(180deg, #f8f9fa 0%, #ffffff 100%)",
          "name": "تدرج البطل"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Cairo', sans-serif",
          "slug": "cairo",
          "name": "القاهرة"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "صغير"
        },
        {
          "slug": "medium",
          "size": "1rem",
          "name": "متوسط"
        },
        {
          "slug": "large",
          "size": "1.125rem",
          "name": "كبير"
        },
        {
          "slug": "x-large",
          "size": "1.5rem",
          "name": "كبير جداً"
        },
        {
          "slug": "xx-large",
          "size": "2rem",
          "name": "ضخم"
        },
        {
          "slug": "xxx-large",
          "size": "2.5rem",
          "name": "ضخم جداً"
        }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"],
      "padding": true,
      "margin": true,
      "spacingSizes": [
        {
          "slug": "30",
          "size": "0.5rem",
          "name": "1"
        },
        {
          "slug": "40",
          "size": "1rem",
          "name": "2"
        },
        {
          "slug": "50",
          "size": "1.5rem",
          "name": "3"
        },
        {
          "slug": "60",
          "size": "2rem",
          "name": "4"
        },
        {
          "slug": "70",
          "size": "3rem",
          "name": "5"
        },
        {
          "slug": "80",
          "size": "5rem",
          "name": "6"
        }
      ]
    },
    "layout": {
      "contentSize": "1280px",
      "wideSize": "1440px"
    },
    "custom": {
      "spacing": {
        "small": "1rem",
        "medium": "2rem",
        "large": "3rem"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--text-dark)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--cairo)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "padding": {
        "top": "0px",
        "right": "0px",
        "bottom": "0px",
        "left": "0px"
      }
    },
    "elements": {
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary-dark-green)",
          "text": "var(--wp--preset--color--white)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--cairo)",
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "600"
        },
        "border": {
          "radius": "0.5rem"
        },
        "spacing": {
          "padding": {
            "top": "1rem",
            "right": "2rem",
            "bottom": "1rem",
            "left": "2rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary-green)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--cairo)",
          "fontWeight": "700",
          "lineHeight": "1.3"
        },
        "color": {
          "text": "var(--wp--preset--color--text-dark)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xxx-large)",
          "fontWeight": "800"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "fontWeight": "700"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "fontWeight": "700"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary-dark-green)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary-green)"
          }
        }
      }
    },
    "blocks": {
      "core/button": {
        "variations": {
          "outline": {
            "color": {
              "background": "transparent",
              "text": "var(--wp--preset--color--primary-dark-green)"
            },
            "border": {
              "color": "var(--wp--preset--color--primary-dark-green)",
              "width": "2px",
              "style": "solid"
            },
            ":hover": {
              "color": {
                "background": "var(--wp--preset--color--primary-dark-green)",
                "text": "var(--wp--preset--color--white)"
              }
            }
          }
        }
      },
      "core/group": {
        "spacing": {
          "padding": {
            "top": "2rem",
            "right": "2rem",
            "bottom": "2rem",
            "left": "2rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "رأس الصفحة",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "تذييل الصفحة",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-home",
      "title": "الصفحة الرئيسية",
      "postTypes": ["page"]
    },
    {
      "name": "page-about",
      "title": "صفحة من نحن",
      "postTypes": ["page"]
    },
    {
      "name": "page-services",
      "title": "صفحة الخدمات",
      "postTypes": ["page"]
    },
    {
      "name": "page-portfolio",
      "title": "صفحة الأعمال",
      "postTypes": ["page"]
    },
    {
      "name": "page-contact",
      "title": "صفحة التواصل",
      "postTypes": ["page"]
    }
  ]
}
